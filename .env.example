APP_NAME="VITI Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=viti_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:9000,localhost:8000
FRONTEND_URLS=http://localhost:9000
FRONTEND_APP_URL=http://localhost:9000

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@viti.local
MAIL_FROM_NAME="AGR Studio · VITI"

FILESYSTEM_DISK=public
CACHE_STORE=file
QUEUE_CONNECTION=sync

VITI_SETUP_SECRET=CAMBIA_ESTA_CLAVE
VITI_ADMIN_SECRET=CAMBIA_ESTA_CLAVE_ADMIN

# Correo transaccional VITI (recomendado en Render Free: API HTTPS de Brevo)
VITI_MAIL_PROVIDER=laravel
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME="AGR Studio · VITI"
BREVO_REPLY_TO_EMAIL=
BREVO_REPLY_TO_NAME="AGR Studio · VITI"

# Voz propia de 006 (ElevenLabs)
# Nunca pongas esta clave en el frontend.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=ZKOQuf0oY2dzqs2f3sdk
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
