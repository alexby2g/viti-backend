APP_NAME="VITI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://viti-core-api-alexby2g.onrender.com
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Neon PostgreSQL
DB_CONNECTION=pgsql
DB_URL=postgresql://USUARIO:PASSWORD@HOST/BASE?sslmode=require
DB_SSLMODE=require

# Sesión web: 12 horas de inactividad, persistida en PostgreSQL y protegida por cookie segura.
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_EXPIRE_ON_CLOSE=false
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true

SANCTUM_STATEFUL_DOMAINS=viti-frontend.vercel.app
FRONTEND_URLS=https://viti-frontend.vercel.app
FRONTEND_APP_URL=https://viti-frontend.vercel.app

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Correo transaccional VITI por API HTTPS de Brevo.
# La API key debe configurarse únicamente como variable secreta en Render.
VITI_MAIL_PROVIDER=brevo
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME="AGR Studio · VITI"
BREVO_REPLY_TO_EMAIL=
BREVO_REPLY_TO_NAME="AGR Studio · VITI"

# Cloudflare R2. Usa DOS buckets: uno público para fotos/logos y otro privado para anexos.
FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DRIVER=s3
PRIVATE_FILESYSTEM_DRIVER=s3
AWS_ACCESS_KEY_ID=TU_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=TU_R2_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=auto
AWS_PUBLIC_BUCKET=viti-public
AWS_PRIVATE_BUCKET=viti-private
AWS_ENDPOINT=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com
# Para pruebas puede ser la Public Development URL de viti-public. En producción usa dominio propio.
AWS_PUBLIC_URL=https://TU_BUCKET_PUBLICO.r2.dev
AWS_USE_PATH_STYLE_ENDPOINT=true

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# CAMBIA ESTOS DOS SECRETOS EN PRODUCCIÓN.
VITI_SETUP_SECRET=CAMBIA_ESTA_CLAVE_DE_INSTALACION
VITI_ADMIN_SECRET=CAMBIA_ESTA_CLAVE_ADMINISTRATIVA

RUN_MIGRATIONS=true
RUN_SEEDER=false
