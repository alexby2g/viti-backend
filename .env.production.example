APP_NAME="VITI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://viti-core-api-alexby2g.onrender.com
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Neon PostgreSQL
DB_CONNECTION=pgsql
DB_URL=postgresql://USUARIO:PASSWORD@HOST/BASE?sslmode=require
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true

# Coloca aquí el dominio real de Vercel cuando lo tengas.
SANCTUM_STATEFUL_DOMAINS=TU-PROYECTO.vercel.app
FRONTEND_URLS=https://TU-PROYECTO.vercel.app
FRONTEND_APP_URL=https://TU-PROYECTO.vercel.app

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Cloudflare R2. Usa DOS buckets: uno público para fotos/logos y otro privado para anexos.
FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DRIVER=s3
PRIVATE_FILESYSTEM_DRIVER=s3
AWS_ACCESS_KEY_ID=TU_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=TU_R2_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=auto
AWS_PUBLIC_BUCKET=viti-public
AWS_PRIVATE_BUCKET=viti-private
AWS_ENDPOINT=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_PUBLIC_URL=https://TU_DOMINIO_PUBLICO_R2
AWS_USE_PATH_STYLE_ENDPOINT=true

# CAMBIA ESTOS DOS SECRETOS EN PRODUCCIÓN.
VITI_SETUP_SECRET=CAMBIA_ESTA_CLAVE_DE_INSTALACION
VITI_ADMIN_SECRET=CAMBIA_ESTA_CLAVE_ADMINISTRATIVA

RUN_MIGRATIONS=true
RUN_SEEDER=true
