APP_NAME="VITI Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
VITI_VERSION=1.1.0

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=viti_db
DB_USERNAME=viti
DB_PASSWORD=viti_local_only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:9000,localhost:8000
FRONTEND_URLS=http://localhost:9000
FRONTEND_APP_URL=http://localhost:9000

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@viti.local
MAIL_FROM_NAME="AGR Studio · VITI"

FILESYSTEM_DISK=public
CACHE_STORE=file
QUEUE_CONNECTION=sync

VITI_SETUP_SECRET=viti-local-setup-secret
VITI_ADMIN_SECRET=viti-local-admin-secret

# Google OAuth — configura estos valores solo en el entorno del servidor.
# El redirect URI debe coincidir exactamente con el registrado en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
VITI_FRONTEND_URL=http://localhost:9000

# Correo transaccional VITI (recomendado en Render Free: API HTTPS de Brevo)
VITI_MAIL_PROVIDER=laravel
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME="AGR Studio · VITI"
BREVO_REPLY_TO_EMAIL=
BREVO_REPLY_TO_NAME="AGR Studio · VITI"

# Voz propia de 006 (ElevenLabs)
# Nunca pongas esta clave en el frontend.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=ZKOQuf0oY2dzqs2f3sdk
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

AGR_OPENAI_ENABLED=false
AGR_AUTOPILOT_ENABLED=false
